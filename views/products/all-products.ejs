<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All products</title>
</head>
<body>
      <%- include('../partials/navbar') %>
    <h1>All product for You</h1>
        
      <% if (Product.length === 0) { %>
        <p>You haven't added any products yet.</p>
    <% } %>

    <% for (let oneProduct of Product) { %>
        
            <h2><%= oneProduct.productName %></h2>
            <p><%= oneProduct.productPrice %></p>
            <p><%= oneProduct.productRiview %></p>

            <a href="/Product/<%= oneProduct._id %>/edit">Edit the Products</a>
            <form action="/Product/<%= oneProduct._id %>?_method=DELETE" method="POST">
                <button type="submit">Delete</button>
            </form>
       
    <% } %>
           
</body>
</html>