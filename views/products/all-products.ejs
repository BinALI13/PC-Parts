<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Products</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('../partials/navbar') %>

<div class="page-container">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="page-title">My Products</h1>
      <p class="page-subtitle mb-0">Manage the products you added</p>
    </div>

    <a href="/Product/create" class="btn btn-main">
      <i class="bi bi-plus-circle"></i> Add Product
    </a>
  </div>

  <% if (Product.length === 0) { %>
    <div class="empty-box">
      <p>You haven't added any products yet</p>
    </div>
  <% } else { %>

    <div class="row g-4">
      <% for (let oneProduct of Product) { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="my-product-card">

            <% if (oneProduct.image) { %>
              <img src="<%= oneProduct.image %>" alt="<%= oneProduct.productName %>">
            <% } %>

            <div class="p-3">
              <h5 class="product-name"><%= oneProduct.productName %></h5>
              <p class="product-price"><%= oneProduct.productPrice %> BHD</p>
              <p class="product-description"><%= oneProduct.productRiview %></p>

              <div class="d-flex gap-2">
                <a href="/Product/<%= oneProduct._id %>/edit" class="btn btn-outline-dark">
                  <i class="bi bi-pencil"></i> Edit
                </a>

                <form action="/Product/<%= oneProduct._id %>?_method=DELETE" method="POST">
                  <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </div>
            </div>

          </div>
        </div>
      <% } %>
    </div>

  <% } %>
</div>

</body>
</html>