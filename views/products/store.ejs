<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Store</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('../partials/navbar') %>

<div class="page-container">
  <h1 class="page-title">Store</h1>
  <p class="page-subtitle">Browse available PC products</p>

  <% if (products.length === 0) { %>
    <div class="empty-box">
      <i class="bi bi-box-seam fs-1"></i>
      <p class="mt-3">No products available</p>
    </div>
  <% } else { %>

    <div class="row g-4">
      <% products.forEach((product) => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="product-card">

            <% if (product.image) { %>
              <img src="<%= product.image %>" class="product-image" alt="<%= product.productName %>">
            <% } %>

            <div class="product-content">
              <h2 class="product-name"><%= product.productName %></h2>
              <p class="product-price"><%= product.productPrice %> BHD</p>
              <p class="product-description"><%= product.productRiview %></p>

            <% if (user && product.owner.toString() !== user._id.toString()) { %>
              
  <form action="/cart/add/<%= product._id %>" method="POST">
    <button type="submit" class="btn btn-main w-100">
      <i class="bi bi-cart-plus"></i> Add to Cart
    </button>
  </form>
<% } %>
            </div>

          </div>
        </div>
      <% }) %>
    </div>

  <% } %>
</div>

</body>
</html>