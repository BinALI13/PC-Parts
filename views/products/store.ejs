</html><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Store</title>
</head>

<body>

  <h1>Store</h1>

  <% if (products.length === 0) { %>

    <p>No products available.</p>

  <% } else { %>

    <% products.forEach((product) => { %>

      <div>
        <h2><%= product.productName %></h2>

        <p>
          Price:
          <%= product.productPrice %> BHD
        </p>

        <p>
          Review:
          <%= product.productRiview %>
        </p>

        <form action="/cart/add/<%= product._id %>" method="POST">
          <button type="submit">
            Add to Cart
          </button>
        </form>

        <hr>
      </div>

    <% }) %>

  <% } %>

</body>
</html>