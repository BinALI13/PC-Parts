<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('./partials/navbar') %>

    <div class="profile">

        <h1>My Profile</h1>

        <h2>Account Information</h2>

        <p><strong>Username:</strong> <%= user.username %></p>
      

        <h2>Delivery Address</h2>

        <form action="/profile/address" method="POST">

            <label>Country</label>

            <select name="country" required>
                <option value="Bahrain">Bahrain</option>
            </select>


            <label>City / Area</label>

            <input
                type="text"
                name="city"
                placeholder="Manama"
                value="<%= address ? address.city : '' %>"
                required
            >


            <label>Block</label>

            <input
                type="text"
                name="block"
                placeholder="777"
                value="<%= address ? address.block : '' %>"
                required
            >


            <label>Road</label>

            <input
                type="text"
                name="road"
                placeholder="1034"
                value="<%= address ? address.road : '' %>"
                required
            >


            <label>Building / House</label>

            <input
                type="text"
                name="building"
                placeholder="345"
                value="<%= address ? address.building : '' %>"
                required
            >


            <button type="submit">Save Address</button>
            <button type ="submit">Delete Address</button>

        </form>


        <% if (address) { %>

            <div class="saved-address">

                <h2>My Saved Address</h2>

                <table>
                    <tr>
                        <th>City</th>
                        <td><%= address.city %></td>
                    </tr>

                    <tr>
                        <th>Block</th>
                        <td><%= address.block %></td>
                    </tr>

                    <tr>
                        <th>Road</th>
                        <td><%= address.road %></td>
                    </tr>

                    <tr>
                        <th>Building</th>
                        <td><%= address.building %></td>
                    </tr>

                </table>

            </div>

        <% } %>

    </div>

</body>

</html>