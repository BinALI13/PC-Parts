<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Profile</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('./partials/navbar') %>

<div class="page-container">
  <h1 class="page-title">My Profile</h1>
  <p class="page-subtitle">Manage your account and delivery address</p>

  <div class="profile-box">
    <h2>Account Information</h2>
    <p><strong>Username:</strong> <%= user.username %></p>

    <hr>

    <h2 class="mt-4">Address</h2>

    <form action="/profile/address" method="POST">
      <div class="mb-3">
        <label class="form-label">Country</label>
        <select name="country" class="form-select" required>
          <option value="Bahrain">Bahrain</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">City / Area</label>
        <input type="text" name="city" class="form-control" placeholder="Manama" value="<%= address ? address.city : '' %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Block</label>
        <input type="text" name="block" class="form-control" placeholder="777" value="<%= address ? address.block : '' %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Road</label>
        <input type="text" name="road" class="form-control" placeholder="1034" value="<%= address ? address.road : '' %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Building / House</label>
        <input type="text" name="building" class="form-control" placeholder="345" value="<%= address ? address.building : '' %>" required>
      </div>

      <button type="submit" class="btn btn-main">
        <i class="bi bi-floppy"></i> Save Address
      </button>
    </form>

    <% if (address) { %>
      <hr class="my-4">

      <h2>Saved Address</h2>

      <div class="table-responsive">
        <table class="table table-bordered address-table">
          <tbody>
            <tr>
              <th>Country</th>
              <td><%= address.country %></td>
            </tr>
            <tr>
              <th>City / Area</th>
              <td><%= address.city %></td>
            </tr>
            <tr>
              <th>Block</th>
              <td><%= address.block %></td>
            </tr>
            <tr>
              <th>Road</th>
              <td><%= address.road %></td>
            </tr>
            <tr>
              <th>Building / House</th>
              <td><%= address.building %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <form action="/profile/address?_method=DELETE" method="POST">
        <button type="submit" class="btn btn-outline-danger">
          <i class="bi bi-trash"></i> Delete Address
        </button>
      </form>
    <% } %>
  </div>
</div>

</body>
</html>