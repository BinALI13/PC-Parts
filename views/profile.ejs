<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Profile</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('./partials/navbar') %>

    <div class="container mt-5 mb-5">

        <div class="card shadow p-4">

            <h1 class="text-center mb-4">My Profile</h1>

            <h2>Account Information</h2>

            <p>
                <strong>Username:</strong>
                <%= user.username %>
            </p>

            <hr>

            <h2>Address</h2>

            <form action="/profile/address" method="POST">

                <div class="mb-3">

                    <label class="form-label">Country</label>

                    <select name="country" class="form-select" required>

                        <option value="Bahrain">
                            Bahrain
                        </option>

                    </select>

                </div>


                <div class="mb-3">

                    <label class="form-label">City / Area</label>

                    <input
                        type="text"
                        name="city"
                        class="form-control"
                        placeholder="EX:Manama"
                        value="<%= address ? address.city : '' %>"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label class="form-label">Block</label>

                    <input
                        type="text"
                        name="block"
                        class="form-control"
                        placeholder="EX:777"
                        value="<%= address ? address.block : '' %>"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label class="form-label">Road</label>

                    <input
                        type="text"
                        name="road"
                        class="form-control"
                        placeholder="EX:1034"
                        value="<%= address ? address.road : '' %>"
                        required
                    >

                </div>


                <div class="mb-3">

                    <label class="form-label">Building / House</label>

                    <input
                        type="text"
                        name="building"
                        class="form-control"
                        placeholder="EX:345"
                        value="<%= address ? address.building : '' %>"
                        required
                    >

                </div>


                <button type="submit" class="btn btn-primary">
                    Save Address
                </button>

            </form>


            <% if (address) { %>

                <hr class="mt-4">

                <h2 class="mb-3">My Saved Address</h2>

                <table class="table table-bordered">

                    <tbody>

                        <tr>
                            <th>Country</th>
                            <td><%= address.country %></td>
                        </tr>

                        <tr>
                            <th>City / Area</th>
                            <td><%= address.city %></td>
                        </tr>

                        <tr>
                            <th>Block</th>
                            <td><%= address.block %></td>
                        </tr>

                        <tr>
                            <th>Road</th>
                            <td><%= address.road %></td>
                        </tr>

                        <tr>
                            <th>Building / House</th>
                            <td><%= address.building %></td>
                        </tr>

                    </tbody>

                </table>


                <form action="/profile/address?_method=DELETE" method="POST">

                    <button type="submit" class="btn btn-danger">
                        Delete Address
                    </button>

                </form>

            <% } %>

        </div>

    </div>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>